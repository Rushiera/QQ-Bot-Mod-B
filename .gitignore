# —— QQBot mod B · 仓库忽略规则 ——
# 原则：源码与档案入库；运行区、外部产物、依赖、安装包不入库。

# 运行区（协议端 NapCat 自带 NTQQ · 事件落盘 · 自测产物）
runtime/*
!runtime/napcat-host/

# 第三方拆包产物（386 MB · 可弃）
_unpack/

# 应用运行数据（日志 / 配置 / 截图）
app/data/

# 依赖
node_modules/

# 安装包（107 MB · 来源物，不入仓）
QQ-Agent V0.4 Preview Bugfix Setup.exe

# 编译产物
bin/
obj/
