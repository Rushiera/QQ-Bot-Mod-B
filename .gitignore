# —— QQBot mod B · 仓库忽略规则 ——
# 原则：源码与档案入库；运行区、外部产物、依赖、安装包不入库。

# 运行区（协议端 NapCat 自带 NTQQ · 事件落盘 · 自测产物）
runtime/*
!runtime/napcat-host/
# napcat-host 只收脚本与配置——Node 运行时（83 MB）不入仓
runtime/napcat-host/node.exe

# 第三方拆包产物（386 MB · 可弃）
_unpack/

# 应用运行数据（日志 / 配置 / 截图）
app/data/

# 依赖
node_modules/

# 安装包（107 MB · 来源物，不入仓）
QQ-Agent V0.4 Preview Bugfix Setup.exe

# 编译产物
bin/
obj/

# 会话中介文件（自测草稿 / 探针 dump）——按收工纪律应当清空；忽略以防漏清入库
CatTemp/
