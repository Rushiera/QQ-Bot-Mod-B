@echo off
rem ===========================================================================
rem QQBot mod B fallback launcher -- BUSINESS LAYER ONLY (no monolith UI)
rem ===========================================================================
rem NOTE: keep this file ASCII-only + CRLF -- cmd parses .bat in GBK on Chinese
rem Windows; UTF-8 Chinese comments / LF endings break parsing.
rem Generated by tools\apply-entry.mjs -- do not hand-edit (regenerate instead).
rem
rem Use this only when the monolith (app\) cannot start: QQ Agent pulls NapCat
rem up by itself (snowluma channel) and the bot keeps running without the UI.
rem Day-to-day entry is the monolith launcher (see tools\apply-entry.mjs).

setlocal
set "ROOT=%~dp0"
set "APPDIR=%ROOT%_unpack"
set "DATADIR=%APPDIR%\data"

echo [1/4] stopping running instances...
taskkill /IM "QQ Agent.exe" /T /F >nul 2>&1
ping -n 3 127.0.0.1 >nul

echo [2/4] clearing instance lock...
if exist "%DATADIR%\qq-agent.lock" del /f /q "%DATADIR%\qq-agent.lock" >nul 2>&1

echo [3/4] opening startup session...
node "%ROOT%tools\open-startup-session.mjs"

echo [4/4] starting app...
rem [qqagent-cwd-patch:launcher-bat] pin the app cwd to _unpack -- never inherit the caller's cwd.
cd /d "%~dp0_unpack" || exit /b 1
start "" "%~dp0_unpack\QQ Agent.exe"
endlocal
